// Netlify serverless function — proxies requests to Anthropic API
// This runs on Netlify's servers, not in the browser, so there is no
// CORS issue and the API key is kept server-side (in Netlify env vars).
//
// Deploy steps:
//   1. In Netlify dashboard → Site → Environment variables
//   2. Add variable:  ANTHROPIC_API_KEY = sk-ant-xxxxxxxx  (your key)
//   3. Redeploy — the function is then live at /.netlify/functions/wine-lookup

exports.handler = async function(event) {
  // Only allow POST
  if (event.httpMethod !== 'POST') {
    return { statusCode: 405, body: 'Method Not Allowed' };
  }

  const apiKey = process.env.ANTHROPIC_API_KEY;
  if (!apiKey) {
    return {
      statusCode: 500,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ error: 'ANTHROPIC_API_KEY not set in Netlify environment variables' })
    };
  }

  let body;
  try { body = JSON.parse(event.body); }
  catch(e) { return { statusCode: 400, body: 'Invalid JSON' }; }

  const query = (body.query || '').trim();
  if (!query) return { statusCode: 400, body: 'Missing query' };

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-beta': 'web-search-2025-03-05'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1500,
        tools: [{ type: 'web_search_20250305', name: 'web_search' }],
        system: `You are an expert wine assistant helping populate a wine cellar app.
Given a wine name, producer, vintage, or barcode number, search the web and return accurate wine details as JSON.

Search reputable sources: winecompanion.com.au, vivino.com, wine-searcher.com, winery websites, therealreview.com, wineenthusiast.com, decanter.com.

Return ONLY a valid JSON object — no markdown fences, no explanation, nothing else before or after the JSON.

Schema (use null or "" for unknown fields):
{"name":"","producer":"","vintage":null,"type":"red","region":"","state":"","country":"","grapes":"","drinkFrom":null,"drinkTo":null,"expertRating":null,"vintageRank":"","foodMatches":""}

Rules:
- type must be one of: red, white, rose, sparkling, dessert, fortified
- vintage, drinkFrom, drinkTo, expertRating: integers or null
- grapes: e.g. "Riesling 100%" or "Shiraz 95%, Cabernet 5%"
- foodMatches: comma-separated e.g. "grilled fish, seafood, Asian cuisine, soft cheeses"
- vintageRank: 1-2 sentences on vintage quality for that region and year
- expertRating: best known score (James Halliday, Wine Advocate, Wine Enthusiast, Decanter)
- For Australian wines always include region, state, country = Australia`,
        messages: [{ role: 'user', content: 'Find wine details for: ' + query }]
      })
    });

    if (!response.ok) {
      const errText = await response.text();
      console.error('Anthropic API error:', response.status, errText);
      return {
        statusCode: response.status,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ error: 'Anthropic API error', status: response.status })
      };
    }

    const data = await response.json();

    // Extract all text blocks (web_search tool produces multiple content blocks)
    const text = (data.content || [])
      .filter(c => c.type === 'text')
      .map(c => c.text || '')
      .join('');

    // Find the JSON object in the response
    const jsonMatch = text.match(/\{[\s\S]*\}/);
    if (!jsonMatch) {
      return {
        statusCode: 200,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ error: 'No wine data found', raw: text.slice(0, 200) })
      };
    }

    const wine = JSON.parse(jsonMatch[0]);
    return {
      statusCode: 200,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*'
      },
      body: JSON.stringify({ wine })
    };

  } catch(e) {
    console.error('Function error:', e);
    return {
      statusCode: 500,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ error: e.message })
    };
  }
};
